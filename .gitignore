# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Frontend
node_modules/
dist/
coverage/
.vite/

# Project-local portable runtimes and environments
runtimes/*
!runtimes/.gitkeep
app/server/.venv/
app/client/node_modules/
app/client/dist/

# Runtime data
*.db
*.sqlite
*.sqlite3
exports/
artifacts/
logs/
app/resources/runtime/*
!app/resources/runtime/.gitkeep
!app/resources/runtime/logs/
app/resources/runtime/logs/*
!app/resources/runtime/logs/.gitkeep
!app/resources/runtime/exports/
app/resources/runtime/exports/*
!app/resources/runtime/exports/.gitkeep

# Model binaries and weights
*.keras
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.tflite
*.mlmodel
*.bin

# Environment and IDE
.env
.env.local
settings/.env
.vscode/
.idea/
.DS_Store
Thumbs.db

# Archives
*.zip

# QA output
assets/QA/*
!assets/QA/.gitkeep

# Keep generated dependency lockfiles under source control.
!app/server/uv.lock
!app/client/package-lock.json
