# ===============================================================================
# Backend Server
# ===============================================================================
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=9850
RELOAD=false
# Set to true to open a dedicated terminal window showing backend logs.
BACKEND_LOGS_VISIBLE=true
NEURO_WEAVE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NEURO_WEAVE_LOG_LEVEL=INFO
NEURO_WEAVE_LOG_FILE=app/resources/runtime/logs/backend.log

# ===============================================================================
# Frontend Server
# ===============================================================================
UI_HOST=127.0.0.1
UI_PORT=6422

# ===============================================================================
# SQLite Database Runtime
# ===============================================================================
DATABASE_SQLITE_PATH=app/resources/database.db
DATABASE_CONNECT_TIMEOUT=60

# ===============================================================================
# Application Runtime
# ===============================================================================
NEURO_WEAVE_EXPORT_ROOT=app/resources/runtime/exports
NEURO_WEAVE_RUNTIME_DISCOVERY_PATH=app/resources/runtime/environment-discovery.json
