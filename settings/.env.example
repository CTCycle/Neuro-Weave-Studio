# NeuroWeave local runtime configuration
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
UI_HOST=127.0.0.1
UI_PORT=5173
VITE_API_BASE_URL=/api
RELOAD=true
ALWAYS_REBUILD=true

# SQLite is the default local database. Set DATABASE_EMBEDDED=false only when
# PostgreSQL has been initialized explicitly through the launcher.
DATABASE_EMBEDDED=true
DATABASE_SQLITE_PATH=app/resources/runtime/neuro_weave.db
DATABASE_URL=
DATABASE_ENGINE=postgresql+psycopg
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=neuro_weave
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_CONNECT_TIMEOUT=30

NEURO_WEAVE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NEURO_WEAVE_LOG_LEVEL=INFO
NEURO_WEAVE_LOG_FILE=app/resources/runtime/logs/backend.log
NEURO_WEAVE_EXPORT_ROOT=app/resources/runtime/exports
