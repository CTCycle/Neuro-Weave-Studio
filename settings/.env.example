# Database mode: true selects embedded SQLite; false selects PostgreSQL.
EMBEDDED_DATABASE=true

# PostgreSQL values. DATABASE_URL may provide the host, port, database name,
# username, and password; explicit DATABASE_* values override URL components.
DATABASE_URL=
DATABASE_ENGINE=postgresql+psycopg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=neuro_weave
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_CONNECT_TIMEOUT=30
DATABASE_INSERT_BATCH_SIZE=1000

# Optional embedded SQLite path. The default is app/resources/runtime/neuro_weave.db.
DATABASE_SQLITE_PATH=

NEURO_WEAVE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
NEURO_WEAVE_LOG_LEVEL=INFO
NEURO_WEAVE_EXPORT_ROOT=./app/resources/runtime/exports
VITE_API_BASE_URL=/api
